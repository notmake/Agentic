# ── 本地推理后端（纯本地，禁止外部 LLM API）──
# 主后端：A800 上的 vLLM（经 SSH 隧道映射到开发机 8001，8000 已被占用）
A800_BASE_URL=http://127.0.0.1:8001/v1
A800_MODEL=Qwen3.8-27B-Q4_K_M

# 开发冒烟回退：双 3060（两者互斥，同一时间只能起一个）
DEV_4B_BASE_URL=http://127.0.0.1:6789/v1
DEV_4B_MODEL=Qwen3.5-4B
DEV_27B_BASE_URL=http://127.0.0.1:6790/v1
DEV_27B_MODEL=Qwen3.8-27B-Q4_K_M

# vLLM 接受任意 key；保留变量是为了统一 Transport 接口
LOCAL_API_KEY=EMPTY

# ── 评测（开发机）──
HF_ENDPOINT=https://hf-mirror.com
SWE_DATASET_REVISION=          # 留空则首次运行自动 pin 并写入 run 元数据
SWE_MAX_WORKERS=4
SWE_TIMEOUT=1800

# ── 运行 ──
DEFAULT_BACKEND=a800_27b       # a800_27b | a800_30b | dev_4b | dev_27b | mock
SWEAGENT_STEP_LIMIT=40
SWEAGENT_WALL_TIME_LIMIT=2400  # 秒
